@startuml 00-mapa-de-modulos
title Aeria Drones — Mapa de módulos
skinparam packageStyle rectangle
skinparam linetype ortho

package "1. Identidade e Acesso" as M1 {
    class Usuario
    class Endereco
}
package "2. Catálogo" as M2 {
    class Produto
}
package "3. Carrinho e Lista de Desejos" as M3 {
    class Carrinho
}
package "4. Pedido e Entrega" as M4 {
    class Pedido
}
package "5. Pagamento" as M5 {
    class Pagamento
}
package "6. Atendimento" as M6 {
    class Chamado
}

Carrinho "*" --> "1" Usuario
Carrinho "*" --> "*" Produto
Pedido "*" --> "1" Usuario
Pedido "*" --> "*" Produto
Pedido "1" --> "1" Pagamento
Pagamento "*" --> "0..1" Usuario
Chamado "*" --> "0..1" Usuario
Chamado "*" --> "0..1" Pedido
Endereco -[hidden]- Usuario
@enduml
{
  "realm": "aeria",
  "enabled": true,
  "sslRequired": "external",
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "eventsEnabled": true,
  "bruteForceProtected": true,
  "directGrantFlow": "aeria direct grant",
  "authenticationFlows": [
    {
      "alias": "aeria direct grant",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "direct-grant-validate-username",
          "requirement": "REQUIRED",
          "priority": 10
        },
        {
          "authenticator": "direct-grant-validate-password",
          "requirement": "REQUIRED",
          "priority": 20
        },
        {
          "flowAlias": "aeria otp condicional",
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 30
        }
      ]
    },
    {
      "alias": "aeria otp condicional",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-configured",
          "requirement": "REQUIRED",
          "priority": 10
        },
        {
          "authenticator": "aeria-direct-grant-otp",
          "requirement": "REQUIRED",
          "priority": 20
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "CLIENTE"
      },
      {
        "name": "ADMINISTRATIVO"
      },
      {
        "name": "ADMIN",
        "composite": true,
        "composites": {
          "realm": [
            "ADMINISTRATIVO"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "aeria-api",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "secret": "${AERIA_KEYCLOAK_CLIENT_SECRET}",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "audiencia aeria-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "aeria-api",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "smtpServer": {
    "host": "${AERIA_SMTP_HOST}",
    "port": "${AERIA_SMTP_PORT}",
    "from": "${AERIA_SMTP_FROM}"
  },
  "users": [
    {
      "id": "aeria-admin",
      "username": "admin@aeria.com.br",
      "firstName": "Administrador",
      "lastName": "Aeria",
      "email": "admin@aeria.com.br",
      "emailVerified": true,
      "enabled": true,
      "realmRoles": [
        "ADMIN"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "aeria123"
        }
      ]
    },
    {
      "id": "aeria-cliente",
      "username": "cliente@aeria.com.br",
      "firstName": "Cliente",
      "lastName": "Semente",
      "email": "cliente@aeria.com.br",
      "emailVerified": true,
      "enabled": true,
      "realmRoles": [
        "CLIENTE"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "aeria123"
        }
      ]
    },
    {
      "id": "aeria-admin-otp",
      "username": "otp@aeria.com.br",
      "firstName": "Administrador",
      "lastName": "OTP",
      "email": "otp@aeria.com.br",
      "emailVerified": true,
      "enabled": true,
      "realmRoles": [
        "ADMIN"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "aeria123"
        },
        {
          "type": "otp",
          "userLabel": "OTP de exemplo",
          "secretData": "{\"value\": \"12345678901234567890\"}",
          "credentialData": "{\"subType\": \"totp\", \"digits\": 6, \"period\": 30, \"algorithm\": \"HmacSHA1\", \"counter\": 0}"
        }
      ]
    },
    {
      "username": "service-account-aeria-api",
      "enabled": true,
      "serviceAccountClientId": "aeria-api",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-realm"
        ]
      }
    }
  ],
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "accessTokenLifespan": 300
}

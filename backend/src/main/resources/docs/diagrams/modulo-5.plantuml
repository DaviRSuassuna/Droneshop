@startuml 05-pagamento
title Módulo 5 — Pagamento
left to right direction
hide empty members
skinparam classAttributeIconSize 0
skinparam class<<externo>> {
    BackgroundColor #F0F0F0
    BorderColor #A0A0A0
    FontColor #707070
}

class Pagamento {
    - id: Long
    - dataPagamento: LocalDateTime
    - valor: BigDecimal
    - parcelas: Integer
    - valorParcela: BigDecimal
    - codigoAutorizacao: String
}
class CartaoSalvo {
    - id: Long
    - ultimosDigitos: String
    - nomeImpresso: String
    - validade: String
    - cpfTitular: String
    - padrao: boolean
}
enum FormaPagamento {
    PIX
    CARTAO_CREDITO
    CARTAO_DEBITO
    BOLETO
    FATURAMENTO_PJ
}
enum StatusPagamento {
    PENDENTE
    APROVADO
    RECUSADO
    ESTORNADO
}
enum BandeiraCartao {
    VISA
    MASTERCARD
    ELO
    AMEX
}
class Pedido <<externo>> {
    - id: Long
    - numero: String
}
class Usuario <<externo>> {
    - id: Long
}
class Endereco <<externo>> {
    - id: Long
}

Pedido "1" *-- "1" Pagamento
Pagamento "*" --> "1" FormaPagamento
Pagamento "*" --> "1" StatusPagamento
Pagamento "*" -- "0..1" CartaoSalvo
CartaoSalvo "*" -- "1" Usuario
CartaoSalvo "*" --> "1" BandeiraCartao
CartaoSalvo "*" -- "1" Endereco : cobrança >

note bottom of CartaoSalvo
  Apenas dados não sensíveis:
  o cartão é tokenizado pelo
  adquirente.
end note
@enduml
@startuml 02-catalogo
title Módulo 2 — Catálogo
left to right direction
hide empty members
skinparam classAttributeIconSize 0
skinparam class<<externo>> {
    BackgroundColor #F0F0F0
    BorderColor #A0A0A0
    FontColor #707070
}

class Produto {
    - id: Long
    - nome: String
    - slug: String
    - sku: String
    - modelo: String
    - descricaoCurta: String
    - descricaoCompleta: String
    - preco: BigDecimal
    - precoPromocional: BigDecimal
    - custo: BigDecimal
    - margem: BigDecimal
    - estoque: Integer
    - estoqueMinimo: Integer
    - garantiaMeses: Integer
    - destaque: boolean
    - certificacaoAnac: String
    - videoDemonstrativoUrl: String
    - manualPdfUrl: String
    - dataLancamento: LocalDate
    - tagsSeo: String
    - pesoFrete: BigDecimal
    - dimensoesEmbalagem: String
    - notaMedia: BigDecimal
    - totalAvaliacoes: Integer
}
class VariacaoProduto {
    - id: Long
    - nome: String
    - sku: String
    - preco: BigDecimal
    - estoque: Integer
}
class ImagemProduto {
    - id: Long
    - url: String
    - ordem: Integer
    - principal: boolean
}
class EspecificacaoTecnica {
    - id: Long
    - peso: Integer
    - dimensoes: String
    - autonomiaVooMin: Integer
    - alcanceTransmissaoKm: BigDecimal
    - velocidadeMaximaKmh: Integer
    - resolucaoCameraMp: Integer
    - sensorCamera: String
    - resolucaoVideo: String
    - estabilizacao: String
    - tipoBateria: String
    - capacidadeMah: Integer
    - tempoCarregamentoMin: Integer
    - gpsIntegrado: boolean
    - sensoresAnticolisao: boolean
}
class Marca {
    - id: Long
    - nome: String
    - slug: String
    - paisOrigem: String
    - siteOficial: String
    - descricao: String
    - logoUrl: String
    - exibirNaHome: boolean
}
class Categoria {
    - id: Long
    - nome: String
    - slug: String
    - descricao: String
    - ordemExibicao: Integer
    - iconeUrl: String
    - exibirNoMenu: boolean
}
class Fornecedor {
    - id: Long
    - nome: String
    - cnpj: String
    - contato: String
}
class Avaliacao {
    - id: Long
    - nota: Integer
    - comentario: String
    - dataCriacao: LocalDateTime
    - compraVerificada: boolean
}
enum StatusPublicacao {
    RASCUNHO
    ATIVO
    INATIVO
}
class Usuario <<externo>> {
    - id: Long
}

Produto "*" -- "1" Marca
Produto "*" -- "1" Categoria
Produto "*" -- "0..1" Fornecedor
Produto "*" --> "1" StatusPublicacao
Produto "1" *-- "1" EspecificacaoTecnica
Produto "1" *-- "*" ImagemProduto
Produto "1" *-- "*" VariacaoProduto
Produto "1" o-- "*" Avaliacao
Produto "*" -- "*" Produto : compatível com >
Marca "*" --> "1" StatusPublicacao
Categoria "0..1" o-- "*" Categoria : categoriaPai
Categoria "*" --> "1" StatusPublicacao
Avaliacao "*" --> "1" Usuario

note bottom of Usuario
  Definido no módulo 1.
end note
note bottom of Produto
  Drones e acessórios usam a mesma
  entidade; a distinção vem da
  Categoria raiz.
end note
@enduml
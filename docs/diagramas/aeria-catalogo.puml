@startuml aeria-catalogo

title Aeria Catálogo

abstract class DefaultEntity <<MappedSuperclass>> {
  -id: Long
  -dataCadastro: LocalDateTime
  -dataAlteracao: LocalDateTime
}

note bottom of DefaultEntity
  Todas as classes herdam
  de DefaultEntity, exceto
  as marcadas <<Embeddable>>
end note

enum StatusMarca {
  RASCUNHO
  ATIVA
  INATIVA
}

class Marca {
  -status: StatusMarca
  -nome: String
  -slug: String
  -paisOrigem: String
  -siteOficial: String
  -descricao: String
  -logoUrl: String
  -destacarHome: boolean
}

enum StatusCategoria {
  RASCUNHO
  ATIVA
  INATIVA
}
note right of StatusCategoria
  Usado por Categoria e Subcategoria.
  RASCUNHO aceita campos vazios (D21)
end note

class Categoria {
  -status: StatusCategoria
  -nome: String
  -slug: String
  -ordemExibicao: Integer
  -descricao: String
  -exibirMenu: boolean
  -iconeUrl: String
}

class Subcategoria {
  -status: StatusCategoria
  -nome: String
  -slug: String
  -ordemExibicao: Integer
  -descricao: String
}

enum StatusFornecedor {
  ATIVO
  INATIVO
}

class Fornecedor {
  -razaoSocial: String
  -cnpj: String
  -nomeContato: String
  -emailContato: String
  -telefoneContato: String
  -endereco: Endereco
  -status: StatusFornecedor
}
note right of Fornecedor
  Contato em três campos (D18).
  cnpj e telefoneContato só com dígitos;
  a máscara fica no front
end note

class Endereco <<Embeddable>> {
  -cep: String
  -logradouro: String
  -numero: String
  -complemento: String
  -bairro: String
  -municipio: Municipio
}
note bottom of Endereco
  Módulo endereco. Colunas embutidas na
  tabela de quem usa (hoje, fornecedor).
  cep só com dígitos; busca via ViaCEP
  no backend, sem bloquear o cadastro
end note

class Municipio {
  -nome: String
  -codigoIbge: Integer
}

class Estado {
  -nome: String
  -sigla: String
  -codigoIbge: Integer
}
note bottom of Estado
  Municipio e Estado: dados oficiais do IBGE,
  somente leitura na API (localidades.sql)
end note

enum StatusProduto {
  RASCUNHO
  ATIVO
  INATIVO
}

abstract class Produto {
  -status: StatusProduto
  -nome: String
  -modelo: String
  -descricaoCurta: String
  -descricao: String
  -slug: String
  -metaTitle: String
  -metaDescription: String
  -tags: String
  -destaque: boolean
  -garantiaMeses: int
  -dataLancamento: LocalDate
}
note right of Produto
  garantiaMeses sobrepõe o padrão de
  ConfiguracaoLoja.prazoGarantiaDias (D15)
end note

class Drone {
  -pesoGramas: int
  -dimensoesDobrado: String
  -dimensoesAberto: String
  -autonomiaMinutos: int
  -alcanceMetros: int
  -velocidadeMaximaKmh: int
  -resolucaoFotoMp: int
  -tipoSensor: String
  -resolucaoVideo: String
  -estabilizacao: String
  -tipoBateria: String
  -capacidadeBateriaMah: int
  -tempoCarregamentoMinutos: int
  -gpsIntegrado: boolean
  -sensoresAnticolisao: boolean
  -exigeRegistroAnac: boolean
  -classeAnac: String
  -registroSisant: String
}
note right of Drone
  Specs como colunas fixas e tipadas (D14).
  pesoGramas é spec de exibição e filtro;
  o peso que cota frete fica na variante
end note

class Acessorio {
  -tipoAcessorio: String
}
note right of Acessorio
  Compatibilidade é relação N:N com Produto (D17),
  não texto. Como Acessorio é Produto, cobre
  acessório-drone e acessório-acessório;
  o vínculo aparece nos dois cadastros
end note

class VarianteProduto {
  -sku: String
  -nome: String
  -precoAdicional: BigDecimal
  -custoAquisicao: BigDecimal
  -estoqueFisico: Integer
  -estoqueMinimo: Integer
  -pesoEmbalagemKg: BigDecimal
  -alturaEmbalagemCm: int
  -larguraEmbalagemCm: int
  -comprimentoEmbalagemCm: int
  -ehKit: boolean
  -ativa: boolean
}
note right of VarianteProduto
  estoqueFisico é nulo quando ehKit=true:
  disponibilidade do kit é derivada do
  mínimo entre componentes disponíveis.
  Peso e dimensões são os da EMBALAGEM,
  base da cotação de frete (D16); no kit,
  derivados dos componentes salvo sobrescrita
end note
note bottom of VarianteProduto
  Reserva, MovimentoEstoque e UnidadeIndividual
  pendem da variante e estão em aeria-estoque.puml
end note

class ComponenteKit {
  -quantidade: int
}

enum TipoMidia {
  IMAGEM
  VIDEO
  MANUAL_PDF
}

class MidiaProduto {
  -tipo: TipoMidia
  -url: String
  -principal: boolean
  -ordem: int
  -altText: String
}

enum EscopoPromocao {
  PRODUTO
  CARRINHO
  FRETE
}

class Promocao {
  -escopo: EscopoPromocao
  -nome: String
  -dataInicio: LocalDateTime
  -dataFim: LocalDateTime
  -percentualDesconto: BigDecimal
  -valorDesconto: BigDecimal
  -valorMinimoCarrinho: BigDecimal
  -ativa: boolean
}

class TermoBuscado {
  -termo: String
  -quantidadeResultados: int
}

Produto <|-- Drone
Produto <|-- Acessorio
Subcategoria "*" --> "1" Categoria
Produto "*" --> "1" Marca
Produto "*" --> "1" Subcategoria
Produto "*" --> "1" Fornecedor
Fornecedor "1" *-- "1" Endereco
Endereco "*" --> "1" Municipio
Municipio "*" --> "1" Estado
Acessorio "*" -- "*" Produto : compatível com
Produto "1" *-- "1..*" VarianteProduto
Produto "1" o-- "*" MidiaProduto
VarianteProduto "1" *-- "*" ComponenteKit : componentes (se kit)
ComponenteKit "*" --> "1" VarianteProduto : componente
Promocao "*" --> "*" VarianteProduto : escopo produto

@enduml

@startuml aeria-identidade

title Aeria Identidade

abstract class DefaultEntity <<MappedSuperclass>> {
  -id: Long
  -dataCadastro: LocalDateTime
  -dataAlteracao: LocalDateTime
}

note bottom of DefaultEntity
  Todas as classes herdam
  de DefaultEntity, exceto
  as marcadas <<Embeddable>>
end note

class Usuario {
  -nome: String
  -email: String
  -keycloakSub: String
  -ativo: boolean
}

enum TipoPessoa {
  PF
  PJ
}

class PerfilCliente {
  -tipoPessoa: TipoPessoa
  -nome: String
  -documento: String
  -telefone: String
}

class EnderecoCliente {
  -apelido: String
  -principal: boolean
}

class Endereco <<Embeddable>> {
  -cep: String
  -logradouro: String
  -numero: String
  -complemento: String
  -bairro: String
}

class Municipio <<externo>> {
  módulo endereco (D32)
}

class ConsentimentoLGPD {
  -tipo: String
  -versao: String
  -dataConsentimento: LocalDateTime
}

class PerfilAdministrativo <<externo>> {
  aeria-administrativo.puml
}

class CartaoSalvo <<externo>> {
  aeria-pagamento.puml
}

class ListaDesejos <<externo>> {
  aeria-compra.puml
}

class Keycloak <<externo>> {
  realm aeria
  sub: String
  papéis: CLIENTE, ADMINISTRATIVO, ADMIN
  credenciais e sessões
}

Usuario --> "1" Keycloak : keycloakSub
Usuario "1" o-- "0..1" PerfilCliente
Usuario "1" o-- "0..1" PerfilAdministrativo
Usuario "1" *-- "*" ConsentimentoLGPD
PerfilCliente "1" *-- "*" EnderecoCliente
EnderecoCliente *-- "1" Endereco
Endereco --> "1" Municipio
PerfilCliente "1" *-- "0..1" ListaDesejos
PerfilCliente "1" *-- "*" CartaoSalvo

@enduml

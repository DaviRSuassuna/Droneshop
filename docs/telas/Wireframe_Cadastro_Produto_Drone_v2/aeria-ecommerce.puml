@startuml aeria-ecommerce
' Diagrama grande: renderizar com limite de tamanho elevado para não cortar em 4096px, ex:
'   PLANTUML_LIMIT_SIZE=16384 plantuml -tpng aeria-ecommerce.puml
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide circle
hide empty members

title Aeria Drones — Domínio E-commerce (Storefront)\nGerado a partir de PRD-Aeria.md v1.1 — companheiro: aeria-administrativo.puml

abstract class DefaultEntity <<mappedsuperclass>> {
  +id: Long
  +criadoEm: LocalDateTime
  +atualizadoEm: LocalDateTime
}

' ===================== Comum =====================
enum OrigemRegistro {
  MANUAL
  SISTEMA
  INTEGRACAO
}
note right of OrigemRegistro
  Quem provocou o registro (D11):
  MANUAL = pessoa (autor preenchido)
  SISTEMA = job interno (autor nulo)
  INTEGRACAO = webhook externo (autor nulo)
end note

' ===================== Identidade e Acesso =====================
package "Identidade e Acesso" {
  class Usuario {
    +email: String
    +senhaHash: String
    +emailVerificado: boolean
    +ativo: boolean
  }

  enum ProvedorSocial {
    GOOGLE
  }

  class ContaSocial {
    +provedor: ProvedorSocial
    +identificadorExterno: String
  }

  enum TipoPessoa {
    PF
    PJ
  }

  class PerfilCliente {
    +nome: String
    +documento: String
    +tipoPessoa: TipoPessoa
    +telefone: String
  }

  class Endereco {
    +apelido: String
    +logradouro: String
    +numero: String
    +complemento: String
    +bairro: String
    +cidade: String
    +uf: String
    +cep: String
    +principal: boolean
  }

  enum PerfilAtivo {
    CLIENTE
    ADMINISTRATIVO
  }

  class SessaoUsuario {
    +token: String
    +perfilAtivo: PerfilAtivo
    +expiraEm: LocalDateTime
    +revogada: boolean
  }

  class ConsentimentoLGPD {
    +tipo: String
    +versao: String
    +dataConsentimento: LocalDateTime
  }

  class PerfilAdministrativo <<externo>> {
  }
}

DefaultEntity <|-- Usuario
DefaultEntity <|-- ContaSocial
DefaultEntity <|-- PerfilCliente
DefaultEntity <|-- Endereco
DefaultEntity <|-- SessaoUsuario
DefaultEntity <|-- ConsentimentoLGPD

Usuario "1" *-- "0..*" ContaSocial
Usuario "1" o-- "0..1" PerfilCliente
Usuario "1" o-- "0..1" PerfilAdministrativo
Usuario "1" *-- "0..*" SessaoUsuario
Usuario "1" *-- "0..*" ConsentimentoLGPD
PerfilCliente "1" *-- "0..*" Endereco

' ===================== Catálogo =====================
package "Catálogo" {
  class Marca {
    +nome: String
    +logoUrl: String
  }

  class Categoria {
    +nome: String
    +slug: String
  }

  class Fornecedor {
    +razaoSocial: String
    +cnpj: String
    +contato: String
  }

  enum StatusProduto {
    RASCUNHO
    ATIVO
    INATIVO
  }

  abstract class Produto {
    +nome: String
    +modelo: String
    +descricaoCurta: String
    +descricao: String
    +slug: String
    +metaTitle: String
    +metaDescription: String
    +tags: String
    +status: StatusProduto
    +destaque: boolean
    +garantiaMeses: int
    +dataLancamento: LocalDate
  }
  note right of Produto
    garantiaMeses sobrepõe o padrão de
    ConfiguracaoLoja.prazoGarantiaDias (D15)
  end note

  class Drone {
    +pesoGramas: int
    +dimensoesDobrado: String
    +dimensoesAberto: String
    +autonomiaMinutos: int
    +alcanceMetros: int
    +velocidadeMaximaKmh: int
    +resolucaoFotoMp: int
    +tipoSensor: String
    +resolucaoVideo: String
    +estabilizacao: String
    +tipoBateria: String
    +capacidadeBateriaMah: int
    +tempoCarregamentoMinutos: int
    +gpsIntegrado: boolean
    +sensoresAnticolisao: boolean
    +exigeRegistroAnac: boolean
    +classeAnac: String
    +registroSisant: String
  }
  note right of Drone
    Specs como colunas fixas e tipadas (D14).
    pesoGramas é spec de exibição e filtro;
    o peso que cota frete fica na variante
  end note

  class Acessorio {
    +tipoAcessorio: String
    +compatibilidade: String
  }

  class VarianteProduto {
    +sku: String
    +nome: String
    +precoAdicional: BigDecimal
    +custoAquisicao: BigDecimal
    +estoqueFisico: Integer
    +estoqueMinimo: Integer
    +pesoEmbalagemKg: BigDecimal
    +alturaEmbalagemCm: int
    +larguraEmbalagemCm: int
    +comprimentoEmbalagemCm: int
    +ehKit: boolean
    +ativa: boolean
  }
  note right of VarianteProduto
    estoqueFisico é nulo quando ehKit=true:
    disponibilidade do kit é derivada do
    mínimo entre componentes disponíveis.
    Peso e dimensões são os da EMBALAGEM,
    base da cotação de frete (D16); no kit,
    derivados dos componentes salvo sobrescrita
  end note

  class ComponenteKit {
    +quantidade: int
  }

  enum TipoMidia {
    IMAGEM
    VIDEO
    MANUAL_PDF
  }

  class MidiaProduto {
    +url: String
    +tipo: TipoMidia
    +principal: boolean
    +ordem: int
    +altText: String
  }

  enum EscopoPromocao {
    PRODUTO
    CARRINHO
    FRETE
  }

  class Promocao {
    +nome: String
    +escopo: EscopoPromocao
    +dataInicio: LocalDateTime
    +dataFim: LocalDateTime
    +percentualDesconto: BigDecimal
    +valorDesconto: BigDecimal
    +valorMinimoCarrinho: BigDecimal
    +ativa: boolean
  }

  class TermoBuscado {
    +termo: String
    +quantidadeResultados: int
  }
}

DefaultEntity <|-- Marca
DefaultEntity <|-- Categoria
DefaultEntity <|-- Fornecedor
DefaultEntity <|-- Produto
DefaultEntity <|-- VarianteProduto
DefaultEntity <|-- ComponenteKit
DefaultEntity <|-- MidiaProduto
DefaultEntity <|-- Promocao
DefaultEntity <|-- TermoBuscado
Produto <|-- Drone
Produto <|-- Acessorio

Categoria "0..1" -- "0..*" Categoria : categoriaPai
Produto "0..*" --> "1" Marca
Produto "0..*" --> "1" Categoria
Produto "0..*" --> "1" Fornecedor
Produto "1" *-- "1..*" VarianteProduto
Produto "1" o-- "0..*" MidiaProduto
VarianteProduto "1" *-- "0..*" ComponenteKit : componentes (se kit)
ComponenteKit "0..*" --> "1" VarianteProduto : componente
Promocao "0..*" --> "0..*" VarianteProduto : escopo produto

' ===================== Estoque =====================
package "Estoque" {
  enum StatusReserva {
    ATIVA
    CONFIRMADA
    EXPIRADA
  }

  class Reserva {
    +quantidade: int
    +expiraEm: LocalDateTime
    +status: StatusReserva
  }
  note bottom of Reserva
    Criada ao entrar no checkout;
    referenciada por ItemCarrinho
    (pacote Carrinho, neste mesmo arquivo)
  end note

  enum TipoMovimento {
    ENTRADA
    SAIDA
    AJUSTE
    DEVOLUCAO
    PERDA
  }

  class MovimentoEstoque {
    +tipo: TipoMovimento
    +quantidade: int
    +saldoResultante: int
    +origem: OrigemRegistro
    +observacao: String
  }

  enum StatusUnidade {
    DISPONIVEL
    RESERVADA
    VENDIDA
    DEVOLVIDA
  }

  class UnidadeIndividual {
    +numeroSerie: String
    +status: StatusUnidade
    +registroAnac: String
    +validadeGarantia: LocalDate
  }
  note bottom of UnidadeIndividual
    Aponta para o ItemPedido na expedição
    (pacote Pedido e Entrega, mesmo arquivo).
    Um ItemPedido com quantidade N recebe
    N unidades (RN12/RN14)
  end note
}

DefaultEntity <|-- Reserva
DefaultEntity <|-- MovimentoEstoque
DefaultEntity <|-- UnidadeIndividual

VarianteProduto "1" *-- "0..*" Reserva
VarianteProduto "1" *-- "0..*" MovimentoEstoque
VarianteProduto "1" *-- "0..*" UnidadeIndividual
MovimentoEstoque "0..*" --> "0..1" Usuario : autor (só se MANUAL)

' ===================== Carrinho e Lista de Desejos =====================
package "Carrinho e Lista de Desejos" {
  enum StatusCarrinho {
    ATIVO
    ABANDONADO
    CONVERTIDO
    EXPIRADO
  }

  class Carrinho {
    +tokenSessao: String
    +status: StatusCarrinho
  }

  class ItemCarrinho {
    +quantidade: int
    +precoUnitarioMomento: BigDecimal
  }

  class ListaDesejos {
  }

  class ItemListaDesejos {
    +adicionadoEm: LocalDateTime
  }

  enum TipoDescontoCupom {
    PERCENTUAL
    VALOR_FIXO
  }

  class Cupom {
    +codigo: String
    +tipoDesconto: TipoDescontoCupom
    +valor: BigDecimal
    +dataInicio: LocalDateTime
    +dataFim: LocalDateTime
    +valorMinimo: BigDecimal
    +limiteTotalUso: int
    +limitePorCliente: int
  }

  class UsoCupom {
    +dataUso: LocalDateTime
  }
}

DefaultEntity <|-- Carrinho
DefaultEntity <|-- ItemCarrinho
DefaultEntity <|-- ListaDesejos
DefaultEntity <|-- ItemListaDesejos
DefaultEntity <|-- Cupom
DefaultEntity <|-- UsoCupom

Carrinho "0..1" --> "0..1" PerfilCliente
Carrinho "0..*" --> "0..1" Cupom : cupomAplicado
Carrinho "1" *-- "0..*" ItemCarrinho
ItemCarrinho "0..*" --> "1" VarianteProduto
ItemCarrinho "1" o-- "0..1" Reserva
PerfilCliente "1" *-- "0..1" ListaDesejos
ListaDesejos "1" *-- "0..*" ItemListaDesejos
ItemListaDesejos "0..*" --> "1" VarianteProduto
Cupom "1" *-- "0..*" UsoCupom
UsoCupom "0..*" --> "1" PerfilCliente
UsoCupom "0..*" --> "1" Pedido
Cupom "0..*" --> "0..*" Categoria : restrição
Cupom "0..*" --> "0..*" Marca : restrição
Cupom "0..*" --> "0..*" VarianteProduto : restrição produto

' ===================== Pedido e Entrega =====================
package "Pedido e Entrega" {
  enum StatusPedido {
    PENDENTE
    PAGO
    SEPARACAO
    ENVIADO
    ENTREGUE
    EM_DEVOLUCAO
    DEVOLVIDO
    CANCELADO
  }

  class Pedido {
    +status: StatusPedido
    +valorTotal: BigDecimal
    +valorFrete: BigDecimal
    +valorDesconto: BigDecimal
  }

  class ItemPedido {
    +quantidade: int
    +precoUnitarioCongelado: BigDecimal
  }

  class HistoricoStatusPedido {
    +statusAnterior: StatusPedido
    +statusNovo: StatusPedido
    +origem: OrigemRegistro
    +observacao: String
  }

  enum ModalidadeEntrega {
    EXPRESSA
    PADRAO
    RETIRADA_SHOWROOM
  }

  enum OrigemCalculoFrete {
    INTEGRACAO_AGREGADOR
    REGRA_FRETE
  }

  class Entrega {
    +modalidade: ModalidadeEntrega
    +origemCalculo: OrigemCalculoFrete
    +transportadora: String
    +codigoServicoTransportadora: String
    +custoCongelado: BigDecimal
    +prazoCongeladoDias: int
    +codigoRastreio: String
  }

  class EventoRastreio {
    +descricao: String
    +localizacao: String
    +dataHora: LocalDateTime
  }

  class EnderecoPedido {
    +destinatario: String
    +logradouro: String
    +numero: String
    +complemento: String
    +bairro: String
    +cidade: String
    +uf: String
    +cep: String
  }
  note bottom of EnderecoPedido
    Fotografia do endereço no momento da compra.
    Editar ou excluir o Endereco do cliente
    não altera pedidos já feitos (RN15)
  end note

  enum OrigemDesconto {
    CUPOM
    PROMOCAO
  }

  class DescontoPedido {
    +origem: OrigemDesconto
    +descricao: String
    +valor: BigDecimal
  }
  note bottom of DescontoPedido
    Dá procedência a Pedido.valorDesconto:
    quanto veio de cada cupom/promoção (RN13)
  end note

  class RegraFrete {
    +modalidade: ModalidadeEntrega
    +custoFixo: BigDecimal
    +prazoDias: int
    +cepOrigem: String
  }
  note bottom of RegraFrete
    Usada só para retirada no showroom
    e como fallback se a integração cair
  end note
}

DefaultEntity <|-- Pedido
DefaultEntity <|-- ItemPedido
DefaultEntity <|-- HistoricoStatusPedido
DefaultEntity <|-- EnderecoPedido
DefaultEntity <|-- DescontoPedido
DefaultEntity <|-- Entrega
DefaultEntity <|-- EventoRastreio
DefaultEntity <|-- RegraFrete

Pedido "0..*" --> "1" PerfilCliente
Pedido "1" *-- "1" EnderecoPedido : enderecoEntrega (congelado)
Pedido "0..*" --> "0..1" Endereco : endereço de origem (referência)
Pedido "1" *-- "0..*" DescontoPedido
DescontoPedido "0..*" --> "0..1" Cupom
DescontoPedido "0..*" --> "0..1" Promocao
Pedido "1" *-- "1..*" ItemPedido
ItemPedido "0..*" --> "1" VarianteProduto
UnidadeIndividual "0..*" --> "0..1" ItemPedido : vendida em
Pedido "1" *-- "0..*" HistoricoStatusPedido
HistoricoStatusPedido "0..*" --> "0..1" Usuario : autor (só se MANUAL)
Pedido "1" *-- "1" Entrega
Entrega "1" *-- "0..*" EventoRastreio
Entrega "0..*" ..> "0..1" RegraFrete : usa (fallback/retirada)

' ===================== Pagamento =====================
package "Pagamento" {
  enum MetodoPagamento {
    PIX
    CARTAO
    BOLETO
    FATURAMENTO_PJ
  }

  enum StatusPagamento {
    PENDENTE
    APROVADO
    RECUSADO
    ESTORNADO
    ESTORNADO_PARCIAL
  }

  class Pagamento {
    +metodo: MetodoPagamento
    +status: StatusPagamento
    +valor: BigDecimal
    +vigente: boolean
    +gatewayTransacaoId: String
  }
  note bottom of Pagamento
    Gateway: Mercado Pago em modo sandbox
    (permanente, sem dinheiro real)
  end note

  class CartaoSalvo {
    +tokenGateway: String
    +ultimosDigitos: String
    +bandeira: String
    +validade: String
  }
  note bottom of CartaoSalvo
    Nunca armazena o número completo
    do cartão (RN11)
  end note

  class Estorno {
    +valor: BigDecimal
    +motivo: String
  }
}

DefaultEntity <|-- Pagamento
DefaultEntity <|-- CartaoSalvo
DefaultEntity <|-- Estorno

Pedido "1" *-- "1..*" Pagamento
PerfilCliente "1" *-- "0..*" CartaoSalvo
Pagamento "1" *-- "0..*" Estorno

' ===================== Fiscal =====================
package "Fiscal" {
  enum TipoOrigemNota {
    VENDA
    DEVOLUCAO
  }

  class NotaFiscal {
    +numero: String
    +serie: String
    +chaveAcesso: String
    +xmlUrl: String
    +danfeUrl: String
    +dataEmissao: LocalDateTime
    +tipoOrigem: TipoOrigemNota
  }
  note bottom of NotaFiscal
    Simulada: emitir() gera identificadores
    fictícios localmente. Sem certificado A1,
    sem SEFAZ, sem emissor terceirizado
  end note
}

DefaultEntity <|-- NotaFiscal
Pedido "1" *-- "0..*" NotaFiscal

' ===================== Devolução =====================
package "Devolução" {
  enum StatusDevolucao {
    SOLICITADA
    EM_ANALISE
    APROVADA
    RECUSADA
    POSTAGEM_REVERSA
    RECEBIDA
    REEMBOLSADA
    CONCLUIDA
  }

  enum ResolucaoDevolucao {
    REEMBOLSO
    TROCA
    REPARO
  }

  class Devolucao {
    +motivo: String
    +status: StatusDevolucao
    +resolucao: ResolucaoDevolucao
    +dataSolicitacao: LocalDateTime
    +dataConclusao: LocalDateTime
  }

  class ItemDevolucao {
    +quantidade: int
  }

  class HistoricoDevolucao {
    +statusAnterior: StatusDevolucao
    +statusNovo: StatusDevolucao
    +origem: OrigemRegistro
    +observacao: String
  }
}

DefaultEntity <|-- Devolucao
DefaultEntity <|-- ItemDevolucao
DefaultEntity <|-- HistoricoDevolucao

Pedido "1" *-- "0..*" Devolucao
Devolucao "1" *-- "1..*" ItemDevolucao
ItemDevolucao "0..*" --> "1" ItemPedido
Devolucao "1" *-- "0..*" HistoricoDevolucao
HistoricoDevolucao "0..*" --> "0..1" Usuario : autor (só se MANUAL)
Devolucao "0..1" --> "0..*" NotaFiscal : pode gerar
Devolucao "0..1" --> "0..*" Estorno : pode gerar

' ===================== Atendimento =====================
package "Atendimento" {
  enum StatusChamado {
    ABERTO
    EM_ANDAMENTO
    ENCERRADO
  }

  class Chamado {
    +assunto: String
    +protocolo: String
    +status: StatusChamado
  }

  enum TipoAutorMensagem {
    CLIENTE
    ATENDENTE
  }

  class MensagemChamado {
    +texto: String
    +tipoAutor: TipoAutorMensagem
  }
}

DefaultEntity <|-- Chamado
DefaultEntity <|-- MensagemChamado

Chamado "0..*" --> "1" PerfilCliente
Chamado "0..1" --> "0..1" Pedido
Chamado "0..*" --> "0..1" Usuario : atendente
Chamado "1" *-- "1..*" MensagemChamado
MensagemChamado "0..*" --> "1" Usuario : autor

' ===================== Avaliações =====================
package "Avaliações" {
  enum StatusModeracao {
    PENDENTE
    APROVADA
    REJEITADA
  }

  class Avaliacao {
    +nota: int
    +comentario: String
    +compraVerificada: boolean
    +status: StatusModeracao
  }

  class Pergunta {
    +texto: String
    +status: StatusModeracao
  }

  class RespostaPergunta {
    +texto: String
  }
}

DefaultEntity <|-- Avaliacao
DefaultEntity <|-- Pergunta
DefaultEntity <|-- RespostaPergunta

Avaliacao "0..*" --> "1" PerfilCliente
Avaliacao "0..*" --> "1" Produto
Avaliacao "0..1" --> "0..1" ItemPedido : origem (compra verificada)
Pergunta "0..*" --> "1" PerfilCliente
Pergunta "0..*" --> "1" Produto
Pergunta "1" *-- "0..*" RespostaPergunta
RespostaPergunta "0..*" --> "1" Usuario : autor

@enduml

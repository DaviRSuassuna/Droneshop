@startuml aeria-administrativo
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide circle
hide empty members

title Aeria Drones — Domínio Administrativo (Back-office)\nGerado a partir de PRD-Aeria.md v1.1 — companheiro: aeria-ecommerce.puml

abstract class DefaultEntity <<mappedsuperclass>> {
  +id: Long
  +criadoEm: LocalDateTime
  +atualizadoEm: LocalDateTime
}

class Usuario <<externo>> {
}
note bottom of Usuario
  Definida em aeria-ecommerce.puml
end note

' ===================== Identidade e Acesso (lado admin) =====================
package "Identidade e Acesso" {
  class PerfilAdministrativo {
    +twoFAHabilitado: boolean
    +twoFASecret: String
  }
}

DefaultEntity <|-- PerfilAdministrativo
' Associação Usuario 1 o-- 0..1 PerfilAdministrativo é declarada
' em aeria-ecommerce.puml e repetida aqui só para leitura isolada
Usuario "1" o-- "0..1" PerfilAdministrativo

' ===================== Papéis e Permissões =====================
package "Papéis e Permissões" {
  enum PapelAdministrativo {
    ADMIN
    OPERADOR
    CATALOGO
    ATENDIMENTO
    SOMENTE_LEITURA
  }

  enum ModuloSistema {
    CATALOGO
    ESTOQUE
    PEDIDO
    PAGAMENTO
    DEVOLUCAO
    ATENDIMENTO
    NOTIFICACAO
    ADMINISTRACAO
  }

  class PermissaoModulo {
    +modulo: ModuloSistema
    +podeVer: boolean
    +podeEditar: boolean
    +podeExcluir: boolean
  }
  note bottom of PermissaoModulo
    Herdada por padrão do papel;
    ajustável individualmente por usuário
  end note
}

DefaultEntity <|-- PermissaoModulo

PerfilAdministrativo "1" --> "1" PapelAdministrativo : papel
PerfilAdministrativo "1" *-- "0..*" PermissaoModulo

' ===================== Auditoria =====================
package "Auditoria" {
  enum AcaoAuditoria {
    CRIACAO
    ATUALIZACAO
    EXCLUSAO
    LOGIN
    MUDANCA_STATUS
  }

  class LogAuditoria {
    +entidade: String
    +entidadeId: Long
    +acao: AcaoAuditoria
    +campo: String
    +valorAnterior: String
    +valorNovo: String
    +ip: String
    +dataHora: LocalDateTime
  }
}

DefaultEntity <|-- LogAuditoria
LogAuditoria "0..*" --> "1" Usuario : autor

' ===================== Configuração da Loja =====================
package "Configuração" {
  class ConfiguracaoLoja {
    +dadosFiscais: String
    +cepOrigemFrete: String
    +remetentePadrao: String
    +prazoArrependimentoDias: int
    +prazoGarantiaDias: int
    +prazoAnaliseDevolucaoDiasUteis: int
    +freteReversoPorContaLoja: boolean
  }
  note bottom of ConfiguracaoLoja
    Registro único (singleton) —
    parâmetros da política de devolução (D8)
  end note
}

DefaultEntity <|-- ConfiguracaoLoja

' ===================== Notificações =====================
package "Notificações" {
  class TemplateNotificacao {
    +codigo: String
    +assunto: String
    +corpoTemplate: String
    +versao: int
    +ativo: boolean
  }
  note bottom of TemplateNotificacao
    Editável pelo administrador,
    com variáveis, sem novo deploy
  end note

  enum CategoriaNotificacao {
    TRANSACIONAL
    MARKETING
  }

  enum StatusEnvioNotificacao {
    ENVIADA
    ENTREGUE
    ABERTA
    BOUNCE
    SPAM
    FALHA
  }

  class Notificacao {
    +categoria: CategoriaNotificacao
    +textoRenderizado: String
    +statusEnvio: StatusEnvioNotificacao
    +identificadorProvedor: String
  }
  note bottom of Notificacao
    Envio real via Resend (plano gratuito).
    textoRenderizado é histórico do que
    foi efetivamente enviado
  end note

  class PreferenciaNotificacao {
    +tipoNotificacao: String
    +habilitado: boolean
  }
}

DefaultEntity <|-- TemplateNotificacao
DefaultEntity <|-- Notificacao
DefaultEntity <|-- PreferenciaNotificacao

Notificacao "0..*" --> "1" TemplateNotificacao
Notificacao "0..*" --> "1" Usuario : destinatario
Usuario "1" *-- "0..*" PreferenciaNotificacao

@enduml
